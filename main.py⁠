import os
import sqlite3
import discord
from discord.ext import commands

# Render 환경변수에서 봇 토큰 가져오기
TOKEN = os.environ.get("DISCORD_TOKEN")

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

# 데이터베이스 초기화 (SQLite)
conn = sqlite3.connect("game_stats.db")
cursor = conn.cursor()
cursor.execute("""
CREATE TABLE IF NOT EXISTS stats (
    user_id INTEGER PRIMARY KEY,
    username TEXT,
    wins INTEGER DEFAULT 0,
    losses INTEGER DEFAULT 0
)
""")
conn.commit()


@bot.event
async def on_ready():
    print(f"Logged in as {bot.user.name}")


@bot.command(name="승리")
async def record_win(ctx, target: discord.Member = None):
    user = target if target else ctx.author
    cursor.execute("SELECT wins FROM stats WHERE user_id = ?", (user.id,))
    row = cursor.fetchone()

    if row is None:
        cursor.execute(
            "INSERT INTO stats (user_id, username, wins, losses) VALUES (?, ?, 1, 0)",
            (user.id, user.display_name),
        )
    else:
        cursor.execute(
            "UPDATE stats SET wins = wins + 1, username = ? WHERE user_id = ?",
            (user.display_name, user.id),
        )

    conn.commit()
    await ctx.send(f"🎉 **{user.display_name}**님의 승리가 기록되었습니다!")


@bot.command(name="패배")
async def record_loss(ctx, target: discord.Member = None):
    user = target if target else ctx.author
    cursor.execute("SELECT losses FROM stats WHERE user_id = ?", (user.id,))
    row = cursor.fetchone()

    if row is None:
        cursor.execute(
            "INSERT INTO stats (user_id, username, wins, losses) VALUES (?, ?, 0, 1)",
            (user.id, user.display_name),
        )
    else:
        cursor.execute(
            "UPDATE stats SET losses = losses + 1, username = ? WHERE user_id = ?",
            (user.display_name, user.id),
        )

    conn.commit()
    await ctx.send(f"💀 **{user.display_name}**님의 패배가 기록되었습니다.")


@bot.command(name="전적")
async def show_stats(ctx, target: discord.Member = None):
    user = target if target else ctx.author
    cursor.execute(
        "SELECT wins, losses FROM stats WHERE user_id = ?", (user.id,)
    )
    row = cursor.fetchone()

    if row is None:
        await ctx.send(
            f"📊 **{user.display_name}**님의 기록된 전적이 없습니다."
        )
    else:
        wins, losses = row
        total = wins + losses
        win_rate = (wins / total * 100) if total > 0 else 0
        await ctx.send(
            f"📊 **{user.display_name}**님의 전적: {wins}승 {losses}패 (승률: {win_rate:.1f}%)"
        )


@bot.command(name="순위")
async def show_leaderboard(ctx):
    cursor.execute(
        "SELECT username, wins, losses FROM stats ORDER BY wins DESC LIMIT 5"
    )
    rows = cursor.fetchall()

    if not rows:
        await ctx.send("🏆 아직 등록된 전적이 없습니다.")
        return

    msg = "🏆 **서버 게임 승리 랭킹 TOP 5**\n"
    for idx, (username, wins, losses) in enumerate(rows, 1):
        total = wins + losses
        win_rate = (wins / total * 100) if total > 0 else 0
        msg += f"{idx}. **{username}**: {wins}승 {losses}패 ({win_rate:.1f}%)\n"

    await ctx.send(msg)


bot.run(TOKEN)
